# --- The IP boundary -------------------------------------------------------
# TAWK binaries/libraries are staged here ephemerally by
# scripts/fetch-tawk-artifacts.sh and must never be committed.
tawk-artifacts/*
!tawk-artifacts/.gitkeep

# No Rust belongs in this repo; if a target/ appears, something went wrong.
target/
Cargo.lock

# --- Secrets ---------------------------------------------------------------
# Generated by provisioning. These normally live in the OpenWrt buildroot, not
# here; ignored anyway as a second line of defence.
tawk-image-credentials.txt
tawk-image-manifest.txt
.tawk-credentials.env
tawk-provision.conf
*.pem
*.key
*.p12
*.hex

# --- Build output ----------------------------------------------------------
*.dtbo
*.img
*.img.gz
*.img.xz
*.sha256
build_dir/
staging_dir/
bin/
dl/

# Optional local guard patterns — never committed.
.guard-patterns
